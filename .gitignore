# EAP-3: container test scratch stays local; measured reports are committed.
EAP_3_Lightweight_Docker/runtime/
!reports/eap3/*.json

# EAP-4: harness scratch stays local; measured run artifacts are committed.
EAP_4_Load_Test/runtime/
!reports/eap4/*.json
!reports/eap4/runs/*/*.json
# The global runs/ rule targets YOLO training output; EAP-4 load-run evidence is committed.
!reports/eap4/runs/

# EAP-5: watchdog runtime state stays local; measured soak/recovery evidence is committed.
EAP_5_Watchdog/runtime/
!EAP_5_Watchdog/configs/*.json
!reports/eap5/*.json
!reports/eap5/soak/*.json

# FDD-1: generated gate artifacts stay local except the committed reports below.
FDD_1_Release_Regression/runtime/
!reports/fdd1/*.json
!reports/fdd1/load/
!reports/fdd1/load/*/*.json

# FDD-2: machine-readable taxonomy is a versioned specification; probe reports are evidence.
!docs/specifications/*.json
!reports/fdd2/*.json

# FDD-3: deployment validation evidence.
!reports/fdd3/*.json

# FDD-4: raw captures stay local; only the final take, its keyframes and recording reports are committed.
FDD_4_Demo/runtime/
reports/fdd4/demo/*.mp4
!reports/fdd4/demo/industrix_demo_20261022T175557Z.mp4
!reports/fdd4/demo/*.png
!reports/fdd4/demo/*.json
!reports/fdd4/*.json
!FDD_4_Demo/*.json

# FDD-5: rehearsal reports and screenshots are evidence; temporary failure fixtures stay local.
FDD_5_Dry_Run/runtime/
!reports/fdd5/*.json
!reports/fdd5/rehearsal/*.json
!reports/fdd5/rehearsal/*/*.png
