# Textile Defect Detection - repository ignore rules

# Dataset directories
dataset/
data/
raw/
raw_dataset/
processed/
processed_dataset/
final_dataset/
kaggle_cache/
content_runtime/
*/content_runtime/
combined_dataset/
*/combined_dataset/
hazard_reports/
*/hazard_reports/

# Dataset/image file formats
*.jpg
*.jpeg
*.png
*.bmp
*.tif
*.tiff
*.webp
*.gif
!SED_3_Stress_Testing/reports/*.png

# Archive files
*.zip
*.tar
*.tar.gz
*.tar.bz2
*.7z
*.rar

# YOLO training output and checkpoints
runs/
weights/
*.pt
*.onnx
*.engine

# Kaggle, Google, and local credentials
kaggle.json
*.json
!package.json
!Confidence_Calibration/benchmark/annotations/*.json
!SED_1_Multi_Camera/reports/*.json
!SED_2_Alert_Escalation/reports/*.json
!SED_3_Stress_Testing/reports/*.json
token.json
credentials.json
service_account*.json
.env
.env.*

# Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Python cache/build output
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Editor and IDE files
.idea/
*.swp
*.swo
*~

# Temporary/scratch files
tmp/
temp/
scratch/
*.tmp
*.log
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat

# CME-2 temporal benchmark local media and generated outputs
Confidence_Calibration/benchmark/media/
Confidence_Calibration/benchmark/clips/
Confidence_Calibration/outputs/
Confidence_Calibration/reports/*.tmp.*
SED_2_Alert_Escalation/runtime/
SED_3_Stress_Testing/reports/smoke_*/

# Experiment tracking generated/local state
Experiment_Tracking/mlruns/
Experiment_Tracking/exports/
.gitignore

# CME-OPT1: lightweight review evidence only; runtime datasets stay ignored
CME_OPT1_Hard_Negative_Augmentation/runtime/
CME_OPT1_Hard_Negative_Augmentation/review_*/
